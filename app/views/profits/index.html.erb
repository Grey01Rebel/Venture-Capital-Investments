<%# Page header %>
<div class="mb-8 border-b border-slate-700 pb-6">
  <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-1">Profits</p>
  <h1 class="text-2xl font-semibold text-white">My Profit Records</h1>
  <p class="mt-1 text-sm text-slate-400">
    A complete history of daily profit generated across your investments.
  </p>
</div>

<% if @profit_records.any? %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead>
      <tr class="border-b border-slate-700">
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Profit Date</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Plan</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Amount</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Investment Status</th>
      </tr>
      </thead>
      <tbody class="divide-y divide-slate-700">
      <% @profit_records.each do |record| %>
        <tr class="hover:bg-slate-700/50 transition-colors">
          <td class="px-6 py-4 text-slate-300">
            <%= record.profit_date.strftime("%b %d, %Y") %>
          </td>
          <td class="px-6 py-4 text-white font-medium">
            <%= record.investment.investment_plan.name %>
          </td>
          <td class="px-6 py-4 text-amber-400 font-medium">
            <%= number_to_currency(record.amount, precision: 2) %>
          </td>
          <td class="px-6 py-4">
            <% if record.investment.active? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-400/10 text-green-400 border border-green-400/30">
                  Active
                </span>
            <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-600/50 text-slate-300 border border-slate-500/30">
                  Completed
                </span>
            <% end %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

<% else %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg px-6 py-10 text-center">
    <p class="text-slate-400 text-sm mb-4">No profit records yet.</p>
    <%= link_to "Browse Investment Plans",
                plans_path,
                class: "inline-block bg-amber-400 hover:bg-amber-300 text-slate-900 font-semibold rounded-md px-5 py-2.5 text-sm transition-colors duration-150" %>
  </div>
<% end %>