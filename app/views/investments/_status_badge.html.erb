<% css_class = case investment.status
               when "active"    then "bg-green-400/10 text-green-400 border border-green-400/30"
               when "completed" then "bg-slate-600/50 text-slate-300 border border-slate-500/30"
               else                  "bg-slate-700 text-slate-400"
               end %>
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= css_class %>">
  <%= investment.status.capitalize %>
</span>