<%# Page header %>
<div class="mb-8 border-b border-slate-700 pb-6">
  <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-1">Investments</p>
  <h1 class="text-2xl font-semibold text-white">My Investments</h1>
  <p class="mt-1 text-sm text-slate-400">
    Your active and completed investment positions.
  </p>
</div>

<% if @investments.any? %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead>
      <tr class="border-b border-slate-700">
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Plan</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Principal</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Daily Return</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Started</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Ends</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Status</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider"></th>
      </tr>
      </thead>
      <tbody class="divide-y divide-slate-700">
      <% @investments.each do |investment| %>
        <tr class="hover:bg-slate-700/50 transition-colors">
          <td class="px-6 py-4 text-white font-medium">
            <%= investment.investment_plan.name %>
          </td>
          <td class="px-6 py-4 text-white">
            <%= number_to_currency(investment.principal_amount, precision: 2) %>
          </td>
          <td class="px-6 py-4 text-amber-400 font-medium">
            <%= number_to_percentage(investment.daily_return_rate, precision: 2) %>
          </td>
          <td class="px-6 py-4 text-slate-300">
            <%= investment.started_at.strftime("%b %d, %Y") %>
          </td>
          <td class="px-6 py-4 text-slate-300">
            <%= investment.ends_at.strftime("%b %d, %Y") %>
          </td>
          <td class="px-6 py-4">
            <%= render "investments/status_badge", investment: investment %>
          </td>
          <td class="px-6 py-4 text-right">
            <%= link_to "View",
                        investment_path(investment),
                        class: "text-amber-400 hover:text-amber-300 text-sm transition-colors" %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

<% else %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg px-6 py-10 text-center">
    <p class="text-slate-400 text-sm mb-4">You have no active investments yet.</p>
    <%= link_to "Browse Investment Plans",
                plans_path,
                class: "inline-block bg-amber-400 hover:bg-amber-300 text-slate-900 font-semibold rounded-md px-5 py-2.5 text-sm transition-colors duration-150" %>
  </div>
<% end %>