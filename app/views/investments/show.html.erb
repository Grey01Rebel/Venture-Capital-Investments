<div class="max-w-2xl mx-auto">

  <%# Page header %>
  <div class="mb-8 border-b border-slate-700 pb-6">
    <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-1">Investment</p>
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-semibold text-white">Investment #<%= @investment.id %></h1>
      <%= render "investments/status_badge", investment: @investment %>
    </div>
    <p class="mt-1 text-sm text-slate-400">
      Started <%= @investment.started_at.strftime("%B %d, %Y") %>
    </p>
  </div>

  <%# Detail card %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg divide-y divide-slate-700 mb-6">

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">Plan</span>
      <span class="text-sm font-medium text-white">
        <%= @investment.investment_plan.name %>
      </span>
    </div>

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">Principal Amount</span>
      <span class="text-sm font-medium text-white">
        <%= number_to_currency(@investment.principal_amount, precision: 2) %>
      </span>
    </div>

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">Daily Return Rate</span>
      <span class="text-sm font-medium text-amber-400">
        <%= number_to_percentage(@investment.daily_return_rate, precision: 2) %>
      </span>
    </div>

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">Duration</span>
      <span class="text-sm font-medium text-white">
        <%= @investment.duration_days %> Days
      </span>
    </div>

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">Started</span>
      <span class="text-sm text-white">
        <%= @investment.started_at.strftime("%B %d, %Y at %H:%M UTC") %>
      </span>
    </div>

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">Ends</span>
      <span class="text-sm text-white">
        <%= @investment.ends_at.strftime("%B %d, %Y at %H:%M UTC") %>
      </span>
    </div>

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">Status</span>
      <%= render "investments/status_badge", investment: @investment %>
    </div>

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">Linked Deposit</span>
      <%= link_to "View Deposit ##{@investment.deposit.id}",
                  deposit_path(@investment.deposit),
                  class: "text-sm text-amber-400 hover:text-amber-300 transition-colors" %>
    </div>

  </div>

  <%# Performance section %>
  <div class="mb-8">
    <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-3">
      Investment Performance
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">

      <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
          Total Profit Earned
        </p>
        <p class="text-2xl font-semibold text-amber-400">
          <%= number_to_currency(@investment.total_profit_earned, precision: 2) %>
        </p>
        <p class="mt-1 text-xs text-slate-500">Cumulative profit to date</p>
      </div>

      <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
          Days Paid
        </p>
        <p class="text-2xl font-semibold text-white">
          <%= @investment.days_paid %> <span class="text-base text-slate-500">/ <%= @investment.duration_days %></span>
        </p>
        <p class="mt-1 text-xs text-slate-500">Profit-bearing days recorded</p>
      </div>

      <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
          Remaining Days
        </p>
        <p class="text-2xl font-semibold text-white">
          <%= @investment.remaining_days %>
        </p>
        <p class="mt-1 text-xs text-slate-500">Days left in the term</p>
      </div>

    </div>

    <%# Progress indicator — pure presentation, no business logic %>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-4">
      <div class="flex justify-between items-center mb-2">
        <span class="text-xs text-slate-400">Term Progress</span>
        <span class="text-xs text-slate-400">
          <%= @investment.days_paid %> of <%= @investment.duration_days %> days
        </span>
      </div>
      <div class="w-full bg-slate-700 rounded-full h-2 overflow-hidden">
        <% progress_percent = @investment.duration_days.zero? ? 0 : [(@investment.days_paid.to_f / @investment.duration_days * 100), 100].min %>
        <div class="bg-amber-400 h-2 rounded-full transition-all duration-300"
             style="width: <%= progress_percent %>%"></div>
      </div>
    </div>
  </div>

  <div class="mt-6 text-center">
    <%= link_to "← Back to My Investments",
                investments_path,
                class: "text-sm text-slate-400 hover:text-amber-400 transition-colors" %>
  </div>

</div>