<%# Page header %>
<div class="mb-8 border-b border-slate-700 pb-6">
  <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-1">Dashboard</p>
  <h1 class="text-2xl font-semibold text-white">
    Welcome back, <span class="text-amber-400"><%= current_user.full_name %></span>
  </h1>
  <p class="mt-1 text-sm text-slate-400">
    Account overview as of <%= Time.current.strftime("%B %d, %Y") %>
  </p>
</div>

<%# Wallet stat cards %>
<% if @wallet %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">

    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
        Available Balance
      </p>
      <p class="text-2xl font-semibold text-white">
        <%= number_to_currency(@wallet.available_balance, precision: 2) %>
      </p>
      <p class="mt-1 text-xs text-slate-500">Funds available for investment</p>
    </div>

    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
        Total Deposited
      </p>
      <p class="text-2xl font-semibold text-white">
        <%= number_to_currency(@wallet.total_deposited, precision: 2) %>
      </p>
      <p class="mt-1 text-xs text-slate-500">Cumulative deposits to date</p>
    </div>

    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
        Total Withdrawn
      </p>
      <p class="text-2xl font-semibold text-white">
        <%= number_to_currency(@wallet.total_withdrawn, precision: 2) %>
      </p>
      <p class="mt-1 text-xs text-slate-500">Cumulative withdrawals to date</p>
    </div>

    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
        Total Profit
      </p>
      <p class="text-2xl font-semibold text-amber-400">
        <%= number_to_currency(@wallet.total_profit, precision: 2) %>
      </p>
      <p class="mt-1 text-xs text-slate-500">Realised returns to date</p>
    </div>

  </div>

  <%# Investment Overview %>
  <div class="mb-10">
    <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-3">
      Investment Overview
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

      <div data-testid="active-investments-card" class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
          Active Investments
        </p>
        <p class="text-2xl font-semibold text-white">
          <%= current_user.active_investments_count %>
        </p>
        <p class="mt-1 text-xs text-slate-500">Currently earning daily profit</p>
      </div>

      <div data-testid="completed-investments-card" class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
          Completed Investments
        </p>
        <p class="text-2xl font-semibold text-white">
          <%= current_user.completed_investments_count %>
        </p>
        <p class="mt-1 text-xs text-slate-500">Investments that have matured</p>
      </div>

      <div data-testid="total-invested-capital-card" class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
          Total Invested Capital
        </p>
        <p class="text-2xl font-semibold text-white">
          <%= number_to_currency(current_user.total_invested_capital, precision: 2) %>
        </p>
        <p class="mt-1 text-xs text-slate-500">Principal across all investments</p>
      </div>

      <div data-testid="total-profit-earned-card" class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
          Total Profit Earned
        </p>
        <p class="text-2xl font-semibold text-amber-400">
          <%= number_to_currency(current_user.total_profit_earned, precision: 2) %>
        </p>
        <p class="mt-1 text-xs text-slate-500">Profit generated across all investments</p>
      </div>

    </div>
  </div>

  <%# Account status strip %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="inline-block w-2 h-2 rounded-full bg-green-400"></span>
      <span class="text-sm text-slate-300">Account active</span>
    </div>
    <span class="text-xs text-slate-500">
      Member since <%= current_user.created_at.strftime("%B %Y") %>
    </span>
  </div>

<% else %>
  <div class="bg-slate-800 border border-amber-600 rounded-lg px-5 py-4">
    <p class="text-sm text-amber-400">
      Your wallet is being set up. Please refresh the page in a moment.
    </p>
  </div>
<% end %>