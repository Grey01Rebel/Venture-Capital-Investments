<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <title>Venture Capital Investments</title>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="h-full bg-slate-900 text-white antialiased">

<%# Navbar %>
<% if user_signed_in? %>
  <div class="flex items-center gap-6">
    <%= link_to "Plans",
                plans_path,
                class: "text-sm text-slate-300 hover:text-amber-400 transition-colors duration-150" %>
    <%= link_to "My Deposits",
                deposits_path,
                class: "text-sm text-slate-300 hover:text-amber-400 transition-colors duration-150" %>
    <% if current_user.admin? %>
      <span class="text-slate-600">|</span>
      <%= link_to "Admin",
                  admin_deposits_path,
                  class: "text-sm text-amber-400 hover:text-amber-300 font-medium transition-colors duration-150" %>
    <% end %>
    <span class="text-slate-600">|</span>
    <span class="text-slate-300 text-sm">
      <%= current_user.full_name %>
    </span>
    <%= button_to "Sign Out",
                  destroy_user_session_path,
                  method: :delete,
                  class: "text-sm text-slate-300 hover:text-amber-400 transition-colors duration-150 cursor-pointer bg-transparent border-0 p-0" %>
  </div>
<% end %>

<%# Flash Messages %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 space-y-2">
  <% if notice.present? %>
    <div class="rounded-md bg-slate-800 border border-green-700 px-4 py-3 text-sm text-green-400">
      <%= notice %>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="rounded-md bg-slate-800 border border-amber-600 px-4 py-3 text-sm text-amber-400">
      <%= alert %>
    </div>
  <% end %>
</div>

<%# Main Content %>
<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= yield %>
</main>

</body>
</html>