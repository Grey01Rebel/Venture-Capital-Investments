<%# Page header %>
<div class="mb-8 border-b border-slate-700 pb-6">
  <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-1">Wallet</p>
  <h1 class="text-2xl font-semibold text-white">Wallet Activity</h1>
  <p class="mt-1 text-sm text-slate-400">
    A complete ledger of activity that has contributed to your wallet balance.
  </p>
</div>

<% if @activity_entries.any? %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead>
      <tr class="border-b border-slate-700">
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Date</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Activity Type</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Investment</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Amount</th>
      </tr>
      </thead>
      <tbody class="divide-y divide-slate-700">
      <% @activity_entries.each do |entry| %>
        <tr class="hover:bg-slate-700/50 transition-colors">
          <td class="px-6 py-4 text-slate-300">
            <%= entry.date.strftime("%b %d, %Y") %>
          </td>
          <td class="px-6 py-4">
            <% if entry.profit_credit? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-400/10 text-amber-400 border border-amber-400/30">
                  Profit Credit
                </span>
            <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-400/10 text-green-400 border border-green-400/30">
                  Principal Return
                </span>
            <% end %>
          </td>
          <td class="px-6 py-4 text-white font-medium">
            <%= entry.investment.investment_plan.name %>
          </td>
          <td class="px-6 py-4 text-amber-400 font-medium">
            <%= number_to_currency(entry.amount, precision: 2) %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

<% else %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg px-6 py-10 text-center">
    <p class="text-slate-400 text-sm mb-4">No wallet activity yet.</p>
    <%= link_to "Browse Investment Plans",
                plans_path,
                class: "inline-block bg-amber-400 hover:bg-amber-300 text-slate-900 font-semibold rounded-md px-5 py-2.5 text-sm transition-colors duration-150" %>
  </div>
<% end %>