<div class="min-h-[80vh] flex items-center justify-center">
  <div class="w-full max-w-md">

    <div class="text-center mb-8">
      <h1 class="text-2xl font-semibold text-white tracking-tight">
        Sign in to your account
      </h1>
      <p class="mt-2 text-sm text-slate-400">
        Enter your credentials to access the platform
      </p>
    </div>

    <div class="bg-slate-800 border border-slate-700 rounded-lg px-8 py-8">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <div class="space-y-5">

          <div>
            <%= f.label :email, "Email address", class: "block text-sm font-medium text-slate-300 mb-1.5" %>
            <%= f.email_field :email,
                              autofocus: true,
                              autocomplete: "email",
                              class: "w-full bg-slate-900 border border-slate-600 rounded-md px-3 py-2.5 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-1 focus:ring-amber-400 focus:border-amber-400 transition-colors" %>
          </div>

          <div>
            <%= f.label :password, "Password", class: "block text-sm font-medium text-slate-300 mb-1.5" %>
            <%= f.password_field :password,
                                 autocomplete: "current-password",
                                 class: "w-full bg-slate-900 border border-slate-600 rounded-md px-3 py-2.5 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-1 focus:ring-amber-400 focus:border-amber-400 transition-colors" %>
          </div>

          <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 cursor-pointer">
              <%= f.check_box :remember_me, class: "rounded border-slate-600 bg-slate-900 text-amber-400 focus:ring-amber-400" %>
              <span class="text-sm text-slate-400">Remember me</span>
            </label>

            <% if devise_mapping.recoverable? && controller_name != "passwords" %>
              <%= link_to "Forgot your password?",
                          new_password_path(resource_name),
                          class: "text-sm text-amber-400 hover:text-amber-300 transition-colors" %>
            <% end %>
          </div>

          <%= f.submit "Sign in",
                       class: "w-full bg-amber-400 hover:bg-amber-300 text-slate-900 font-semibold rounded-md px-4 py-2.5 text-sm transition-colors duration-150 cursor-pointer mt-2" %>

        </div>
      <% end %>
    </div>

    <div class="mt-6 text-center text-sm text-slate-400">
      Don't have an account?
      <%= link_to "Create one",
                  new_registration_path(resource_name),
                  class: "text-amber-400 hover:text-amber-300 transition-colors font-medium" %>
    </div>

  </div>
</div>