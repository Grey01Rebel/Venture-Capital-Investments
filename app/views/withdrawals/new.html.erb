<div class="max-w-xl mx-auto">

  <div class="mb-8 border-b border-slate-700 pb-6">
    <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-1">Withdrawals</p>
    <h1 class="text-2xl font-semibold text-white">Request a Withdrawal</h1>
  </div>

  <div class="bg-slate-800 border border-slate-700 rounded-lg px-6 py-5 mb-6">
    <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-1">Available Balance</p>
    <p class="text-2xl font-semibold text-amber-400">
      <%= number_with_precision(@wallet.available_balance, precision: 8) %> BTC
    </p>
  </div>

  <% if flash[:alert] %>
    <div class="bg-red-900/30 border border-red-700 rounded-lg px-4 py-3 mb-6">
      <p class="text-sm text-red-400"><%= flash[:alert] %></p>
    </div>
  <% end %>

  <%= form_with model: @withdrawal, url: withdrawals_path, local: true, class: "space-y-5" do |f| %>

    <div>
      <%= f.label :amount, "Withdrawal Amount (BTC)", class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.text_field :amount,
                       step: "0.00000001",
                       placeholder: "0.00000000",
                       class: "w-full bg-slate-900 border border-slate-700 rounded-md px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-400" %>
    </div>

    <div>
      <%= f.label :btc_address, "Destination BTC Address", class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.text_field :btc_address,
                       placeholder: "bc1q...",
                       class: "w-full bg-slate-900 border border-slate-700 rounded-md px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-400" %>
    </div>

    <%= f.submit "Submit Withdrawal Request",
                 class: "w-full bg-amber-400 hover:bg-amber-300 text-slate-900 font-semibold rounded-md px-5 py-3 text-sm transition-colors duration-150 cursor-pointer" %>

  <% end %>

  <div class="mt-6 text-center">
    <%= link_to "← Back to My Withdrawals",
                withdrawals_path,
                class: "text-sm text-slate-400 hover:text-amber-400 transition-colors" %>
  </div>

</div>