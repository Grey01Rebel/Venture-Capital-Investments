<div class="mb-8 border-b border-slate-700 pb-6 flex items-center justify-between">
  <div>
    <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-1">Withdrawals</p>
    <h1 class="text-2xl font-semibold text-white">My Withdrawals</h1>
  </div>
  <%= link_to "Request Withdrawal",
              new_withdrawal_path,
              class: "bg-amber-400 hover:bg-amber-300 text-slate-900 font-semibold rounded-md px-5 py-2.5 text-sm transition-colors duration-150" %>
</div>

<% if @withdrawals.any? %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead>
      <tr class="border-b border-slate-700">
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Requested</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Amount</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Status</th>
      </tr>
      </thead>
      <tbody class="divide-y divide-slate-700">
      <% @withdrawals.each do |withdrawal| %>
        <tr class="hover:bg-slate-700/50 transition-colors cursor-pointer"
            onclick="window.location='<%= withdrawal_path(withdrawal) %>'">
          <td class="px-6 py-4 text-slate-300">
            <%= withdrawal.requested_at.strftime("%b %d, %Y") %>
          </td>
          <td class="px-6 py-4 text-white font-medium">
            <%= number_with_precision(withdrawal.amount, precision: 8) %> BTC
          </td>
          <td class="px-6 py-4">
            <%= render "withdrawals/status_badge", withdrawal: withdrawal %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg px-6 py-10 text-center">
    <p class="text-slate-400 text-sm mb-4">No withdrawal requests yet.</p>
    <%= link_to "Request a Withdrawal",
                new_withdrawal_path,
                class: "inline-block bg-amber-400 hover:bg-amber-300 text-slate-900 font-semibold rounded-md px-5 py-2.5 text-sm transition-colors duration-150" %>
  </div>
<% end %>