<div class="mb-6 border-b border-slate-700 pb-6">
  <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-1">Admin</p>
  <h1 class="text-2xl font-semibold text-white">Withdrawal Requests</h1>
</div>

<%# Status filter tabs %>
<div class="flex gap-2 mb-6">
  <% [["pending", "Pending"], ["approved", "Approved"], ["rejected", "Rejected"], ["completed", "Completed"]].each do |value, label| %>
    <%= link_to label,
          admin_withdrawals_path(status: value),
          class: "px-4 py-2 rounded-md text-sm font-medium transition-colors #{@status_filter == value ? 'bg-amber-400 text-slate-900' : 'bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700'}" %>
  <% end %>
</div>

<% if @withdrawals.any? %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-700">
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">User</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Amount</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Requested</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-700">
        <% @withdrawals.each do |withdrawal| %>
          <tr class="hover:bg-slate-700/50 transition-colors">
            <td class="px-6 py-4 text-white"><%= withdrawal.user.full_name %></td>
            <td class="px-6 py-4 text-white font-medium">
              <%= number_with_precision(withdrawal.amount, precision: 8) %> BTC
            </td>
            <td class="px-6 py-4">
              <%= render "withdrawals/status_badge", withdrawal: withdrawal %>
            </td>
            <td class="px-6 py-4 text-slate-300">
              <%= withdrawal.requested_at.strftime("%b %d, %Y") %>
            </td>
            <td class="px-6 py-4">
              <%= link_to "Review",
                    admin_withdrawal_path(withdrawal),
                    class: "text-sm text-amber-400 hover:text-amber-300 transition-colors" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg px-6 py-10 text-center">
    <p class="text-slate-400 text-sm">No <%= @status_filter %> withdrawal requests.</p>
  </div>
<% end %>
