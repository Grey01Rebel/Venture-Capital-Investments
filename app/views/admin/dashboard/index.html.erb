<%# Page header %>
<div class="mb-8 border-b border-slate-700 pb-6">
  <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-1">Admin</p>
  <h1 class="text-2xl font-semibold text-white">Operations Dashboard</h1>
  <p class="mt-1 text-sm text-slate-400">
    Platform overview as of <%= Time.current.strftime("%B %d, %Y at %H:%M UTC") %>
  </p>
</div>

<%# Platform Overview %>
<div class="mb-8">
  <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-3">Platform Overview</p>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Total Users</p>
      <p class="text-2xl font-semibold text-white"><%= @total_users %></p>
    </div>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Members</p>
      <p class="text-2xl font-semibold text-white"><%= @total_members %></p>
    </div>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Administrators</p>
      <p class="text-2xl font-semibold text-white"><%= @total_admins %></p>
    </div>
  </div>
</div>

<%# Deposits %>
<div class="mb-8">
  <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-3">Deposits</p>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-slate-800 border border-amber-600/40 rounded-lg px-5 py-5"
         data-testid="pending-deposits-card">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Pending</p>
      <p class="text-2xl font-semibold text-amber-400"><%= @pending_deposits %></p>
      <p class="mt-1 text-xs text-slate-500">Awaiting review</p>
    </div>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Approved</p>
      <p class="text-2xl font-semibold text-white"><%= @approved_deposits %></p>
    </div>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Rejected</p>
      <p class="text-2xl font-semibold text-white"><%= @rejected_deposits %></p>
    </div>
  </div>
</div>

<%# Withdrawals %>
<div class="mb-8">
  <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-3">Withdrawals</p>
  <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
    <div class="bg-slate-800 border border-amber-600/40 rounded-lg px-5 py-5"
         data-testid="pending-withdrawals-card">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Pending</p>
      <p class="text-2xl font-semibold text-amber-400"><%= @pending_withdrawals %></p>
      <p class="mt-1 text-xs text-slate-500">Awaiting review</p>
    </div>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Approved</p>
      <p class="text-2xl font-semibold text-white"><%= @approved_withdrawals %></p>
    </div>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Completed</p>
      <p class="text-2xl font-semibold text-green-400"><%= @completed_withdrawals %></p>
    </div>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Rejected</p>
      <p class="text-2xl font-semibold text-white"><%= @rejected_withdrawals %></p>
    </div>
  </div>
</div>

<%# Investments %>
<div class="mb-8">
  <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-3">Investments</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5"
         data-testid="active-investments-card">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Active</p>
      <p class="text-2xl font-semibold text-white"><%= @active_investments %></p>
      <p class="mt-1 text-xs text-slate-500">Currently earning profit</p>
    </div>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Completed</p>
      <p class="text-2xl font-semibold text-white"><%= @completed_investments %></p>
    </div>
  </div>
</div>

<%# Financial Overview %>
<div class="mb-8">
  <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-3">Financial Overview</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Total BTC Available</p>
      <p class="text-2xl font-semibold text-amber-400">
        <%= number_with_precision(@total_btc_available, precision: 8) %> BTC
      </p>
      <p class="mt-1 text-xs text-slate-500">Across all wallets</p>
    </div>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Total Invested Capital</p>
      <p class="text-2xl font-semibold text-white">
        <%= number_to_currency(@total_invested_capital, precision: 2) %>
      </p>
      <p class="mt-1 text-xs text-slate-500">Principal across all investments</p>
    </div>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Total Profit Paid</p>
      <p class="text-2xl font-semibold text-amber-400">
        <%= number_to_currency(@total_profit_paid, precision: 2) %>
      </p>
      <p class="mt-1 text-xs text-slate-500">Sum of all profit records</p>
    </div>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-5 py-5">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Principal Returned</p>
      <p class="text-2xl font-semibold text-white">
        <%= number_to_currency(@total_principal_returned, precision: 2) %>
      </p>
      <p class="mt-1 text-xs text-slate-500">From completed investments</p>
    </div>
  </div>
</div>

<%# Recent Activity %>
<div>
  <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-3">Recent Activity</p>
  <% if @recent_activity.any? %>
    <div class="bg-slate-800 border border-slate-700 rounded-lg overflow-hidden">
      <table class="w-full text-sm">
        <thead>
        <tr class="border-b border-slate-700">
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Event</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">User</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Amount</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">When</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-slate-700">
        <% @recent_activity.each do |event| %>
          <tr class="hover:bg-slate-700/50 transition-colors">
            <td class="px-6 py-4 text-white font-medium">
              <%= event[:type] %>
              <% if event[:label].present? %>
                <span class="text-slate-400 font-normal"> — <%= event[:label] %></span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-slate-300"><%= event[:user] %></td>
            <td class="px-6 py-4 text-amber-400 font-medium">
              <% if event[:unit] == "BTC" %>
                <%= number_with_precision(event[:amount], precision: 8) %> BTC
              <% else %>
                <%= number_to_currency(event[:amount], precision: 2) %>
              <% end %>
            </td>
            <td class="px-6 py-4">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-700 text-slate-300">
                  <%= event[:status].to_s.capitalize %>
                </span>
            </td>
            <td class="px-6 py-4 text-slate-400 text-xs">
              <%= event[:occurred_at].strftime("%b %d, %Y") %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-slate-800 border border-slate-700 rounded-lg px-6 py-10 text-center">
      <p class="text-slate-400 text-sm">No recent activity to display.</p>
    </div>
  <% end %>
</div>