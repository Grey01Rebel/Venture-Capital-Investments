<div class="mb-6 border-b border-slate-700 pb-6">
  <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-1">Admin</p>
  <h1 class="text-2xl font-semibold text-white">Investments</h1>
</div>

<%# Status filter tabs %>
<div class="flex gap-2 mb-4">
  <%= link_to "All",
              admin_investments_path(search: @search.presence),
              class: "px-4 py-2 rounded-md text-sm font-medium transition-colors #{@status_filter.blank? ? 'bg-amber-400 text-slate-900' : 'bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700'}" %>
  <% [["active", "Active"], ["completed", "Completed"]].each do |value, label| %>
    <%= link_to label,
                admin_investments_path(status: value, search: @search.presence),
                class: "px-4 py-2 rounded-md text-sm font-medium transition-colors #{@status_filter == value ? 'bg-amber-400 text-slate-900' : 'bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700'}" %>
  <% end %>
</div>

<%# Search form %>
<%= render "admin/shared/search_form",
           url:            admin_investments_path,
           status_filter:  @status_filter,
           current_search: @search,
           placeholder:    "Search by investor name, email, or plan..." %>

<% if @investments.any? %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead>
      <tr class="border-b border-slate-700">
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Investor</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Plan</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Principal</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Status</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Started</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Ends</th>
      </tr>
      </thead>
      <tbody class="divide-y divide-slate-700">
      <% @investments.each do |investment| %>
        <tr class="hover:bg-slate-700/50 transition-colors">
          <td class="px-6 py-4 text-white"><%= investment.user.full_name %></td>
          <td class="px-6 py-4 text-slate-300"><%= investment.investment_plan.name %></td>
          <td class="px-6 py-4 text-white font-medium">
            <%= number_to_currency(investment.principal_amount, precision: 2) %>
          </td>
          <td class="px-6 py-4">
            <% if investment.active? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-400/10 text-green-400 border border-green-400/30">
                  Active
                </span>
            <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-600/50 text-slate-300 border border-slate-500/30">
                  Completed
                </span>
            <% end %>
          </td>
          <td class="px-6 py-4 text-slate-300">
            <%= investment.started_at.strftime("%b %d, %Y") %>
          </td>
          <td class="px-6 py-4 text-slate-300">
            <%= investment.ends_at.strftime("%b %d, %Y") %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex justify-center">
    <%== pagy_nav(@pagy) %>
  </div>
<% else %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg px-6 py-10 text-center">
    <p class="text-slate-400 text-sm">
      <% if @search.present? %>
        No investments found matching "<%= @search %>".
      <% else %>
        No <%= @status_filter.present? ? @status_filter : "" %> investments found.
      <% end %>
    </p>
  </div>
<% end %>