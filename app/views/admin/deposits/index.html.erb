<%# Page header %>
<div class="mb-8 border-b border-slate-700 pb-6">
  <p class="text-sm text-amber-400 uppercase tracking-widest font-medium mb-1">Admin</p>
  <h1 class="text-2xl font-semibold text-white">Deposit Review</h1>
  <p class="mt-1 text-sm text-slate-400">
    Review and action pending deposit submissions.
  </p>
</div>

<%# Status filter tabs %>
<div class="flex gap-2 mb-6">
  <% %w[pending approved rejected].each do |status| %>
    <%= link_to status.capitalize,
                admin_deposits_path(status: status),
                class: "px-4 py-2 rounded-md text-sm font-medium transition-colors duration-150 #{
                  @status_filter == status ?
                    'bg-amber-400 text-slate-900' :
                    'bg-slate-800 text-slate-300 hover:text-white border border-slate-700'
                }" %>
  <% end %>
</div>

<% if @deposits.any? %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead>
      <tr class="border-b border-slate-700">
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">User</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Plan</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Amount</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">BTC Sent</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Status</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Submitted</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider"></th>
      </tr>
      </thead>
      <tbody class="divide-y divide-slate-700">
      <% @deposits.each do |deposit| %>
        <tr class="hover:bg-slate-700/50 transition-colors">
          <td class="px-6 py-4">
            <p class="text-white font-medium text-sm"><%= deposit.user.full_name %></p>
            <p class="text-slate-500 text-xs"><%= deposit.user.email %></p>
          </td>
          <td class="px-6 py-4 text-white">
            <%= deposit.investment_plan.name %>
          </td>
          <td class="px-6 py-4 text-white">
            <%= number_to_currency(deposit.amount_usd, precision: 2) %>
          </td>
          <td class="px-6 py-4 text-slate-300 font-mono text-xs">
            <%= deposit.btc_amount.to_s("F") %> BTC
          </td>
          <td class="px-6 py-4">
            <%= render "deposits/status_badge", deposit: deposit %>
          </td>
          <td class="px-6 py-4 text-slate-400 text-sm">
            <%= deposit.submitted_at.strftime("%b %d, %Y") %>
          </td>
          <td class="px-6 py-4 text-right">
            <%= link_to "Review",
                        admin_deposit_path(deposit),
                        class: "text-amber-400 hover:text-amber-300 text-sm transition-colors" %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

<% else %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg px-6 py-10 text-center">
    <p class="text-slate-400 text-sm">
      No <%= @status_filter %> deposits found.
    </p>
  </div>
<% end %>