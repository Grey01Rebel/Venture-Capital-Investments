<div class="mb-6 border-b border-slate-700 pb-6">
  <p class="text-sm text-slate-400 uppercase tracking-widest font-medium mb-1">Admin</p>
  <h1 class="text-2xl font-semibold text-white">Deposit Review</h1>
</div>

<%# Status filter tabs %>
<div class="flex gap-2 mb-4">
  <% [["pending", "Pending"], ["approved", "Approved"], ["rejected", "Rejected"]].each do |value, label| %>
    <%= link_to label,
                admin_deposits_path(status: value, search: @search.presence),
                class: "px-4 py-2 rounded-md text-sm font-medium transition-colors #{@status_filter == value ? 'bg-amber-400 text-slate-900' : 'bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700'}" %>
  <% end %>
</div>

<%# Search form %>
<%= render "admin/shared/search_form",
           url:            admin_deposits_path,
           status_filter:  @status_filter,
           current_search: @search,
           placeholder:    "Search by name, email, or transaction hash..." %>

<% if @deposits.any? %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead>
      <tr class="border-b border-slate-700">
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">User</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Plan</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Amount</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Status</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Submitted</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider">Action</th>
      </tr>
      </thead>
      <tbody class="divide-y divide-slate-700">
      <% @deposits.each do |deposit| %>
        <tr class="hover:bg-slate-700/50 transition-colors">
          <td class="px-6 py-4 text-white"><%= deposit.user.full_name %></td>
          <td class="px-6 py-4 text-slate-300"><%= deposit.investment_plan.name %></td>
          <td class="px-6 py-4 text-white font-medium">
            <%= number_to_currency(deposit.amount_usd, precision: 2) %>
          </td>
          <td class="px-6 py-4">
            <%= render "deposits/status_badge", deposit: deposit %>
          </td>
          <td class="px-6 py-4 text-slate-300">
            <%= deposit.submitted_at.strftime("%b %d, %Y") %>
          </td>
          <td class="px-6 py-4">
            <%= link_to "Review",
                        admin_deposit_path(deposit),
                        class: "text-sm text-amber-400 hover:text-amber-300 transition-colors" %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex justify-center">
    <%== pagy_nav(@pagy) %>
  </div>
<% else %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg px-6 py-10 text-center">
    <p class="text-slate-400 text-sm">
      <% if @search.present? %>
        No deposits found matching "<%= @search %>".
      <% else %>
        No <%= @status_filter %> deposits.
      <% end %>
    </p>
  </div>
<% end %>