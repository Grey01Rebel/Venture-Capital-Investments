<div class="max-w-2xl mx-auto">

  <%# Page header %>
  <div class="mb-8 border-b border-slate-700 pb-6">
    <p class="text-sm text-amber-400 uppercase tracking-widest font-medium mb-1">Admin — Deposit Review</p>
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-semibold text-white">Deposit #<%= @deposit.id %></h1>
      <%= render "deposits/status_badge", deposit: @deposit %>
    </div>
    <p class="mt-1 text-sm text-slate-400">
      Submitted <%= @deposit.submitted_at.strftime("%B %d, %Y at %H:%M UTC") %>
    </p>
  </div>

  <%# Deposit detail card %>
  <div class="bg-slate-800 border border-slate-700 rounded-lg divide-y divide-slate-700 mb-6">

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">User</span>
      <div class="text-right">
        <p class="text-sm font-medium text-white"><%= @deposit.user.full_name %></p>
        <p class="text-xs text-slate-500"><%= @deposit.user.email %></p>
      </div>
    </div>

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">Plan</span>
      <span class="text-sm font-medium text-white">
        <%= @deposit.investment_plan.name %>
      </span>
    </div>

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">Investment Amount</span>
      <span class="text-sm font-medium text-white">
        <%= number_to_currency(@deposit.amount_usd, precision: 2) %>
      </span>
    </div>

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">BTC Amount Sent</span>
      <span class="text-sm font-medium text-white font-mono">
        <%= @deposit.btc_amount.to_s("F") %> BTC
      </span>
    </div>

    <div class="px-6 py-4">
      <p class="text-sm text-slate-400 mb-1">Transaction Hash</p>
      <p class="text-sm font-mono text-white break-all"><%= @deposit.transaction_hash %></p>
    </div>

    <div class="px-6 py-4 flex justify-between items-center">
      <span class="text-sm text-slate-400">Status</span>
      <%= render "deposits/status_badge", deposit: @deposit %>
    </div>

  </div>

  <%# Review action — only for pending deposits %>
  <% if @deposit.pending? %>
    <%= render "admin/deposits/review_action", deposit: @deposit %>
  <% else %>
    <%= render "admin/deposits/review_record", deposit: @deposit %>
  <% end %>

  <div class="mt-6 text-center">
    <%= link_to "← Back to Deposit Review",
                admin_deposits_path,
                class: "text-sm text-slate-400 hover:text-amber-400 transition-colors" %>
  </div>

</div>