<div class="bg-slate-800 border border-slate-700 rounded-lg px-6 py-6">
  <p class="text-sm font-medium text-slate-300 mb-4">Review Decision</p>

  <div class="flex gap-3">

    <%= form_with url: approve_admin_deposit_path(deposit),
                  method: :patch,
                  class: "flex-1" do %>
      <div class="mb-4">
        <%= label_tag :admin_notes, class: "block text-sm font-medium text-slate-300 mb-1.5" do %>
          Admin Notes <span class="text-slate-500 font-normal">(optional)</span>
        <% end %>
        <%= text_area_tag :admin_notes,
                          nil,
                          rows: 3,
                          placeholder: "Add internal notes about this deposit...",
                          class: "w-full bg-slate-900 border border-slate-600 rounded-md px-3 py-2.5 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-1 focus:ring-amber-400 focus:border-amber-400 transition-colors resize-none" %>
      </div>
      <button type="submit"
              class="w-full bg-green-600 hover:bg-green-500 text-white font-semibold rounded-md px-4 py-2.5 text-sm transition-colors duration-150 cursor-pointer">
        Approve Deposit
      </button>
    <% end %>

    <%= form_with url: reject_admin_deposit_path(deposit),
                  method: :patch,
                  class: "flex-1" do %>
      <div class="mb-4">
        <%= label_tag :admin_notes, class: "block text-sm font-medium text-slate-300 mb-1.5" do %>
          Admin Notes <span class="text-slate-500 font-normal">(optional)</span>
        <% end %>
        <%= text_area_tag :admin_notes,
                          nil,
                          rows: 3,
                          placeholder: "Add internal notes about this deposit...",
                          class: "w-full bg-slate-900 border border-slate-600 rounded-md px-3 py-2.5 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-1 focus:ring-amber-400 focus:border-amber-400 transition-colors resize-none" %>
      </div>
      <button type="submit"
              class="w-full bg-red-700 hover:bg-red-600 text-white font-semibold rounded-md px-4 py-2.5 text-sm transition-colors duration-150 cursor-pointer">
        Reject Deposit
      </button>
    <% end %>

  </div>

  <p class="mt-3 text-xs text-slate-500 text-center">
    This action is permanent and cannot be undone.
  </p>
</div>