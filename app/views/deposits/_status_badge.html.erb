<% css_class = case deposit.status
               when "pending"  then "bg-amber-400/10 text-amber-400 border border-amber-400/30"
               when "approved" then "bg-green-400/10 text-green-400 border border-green-400/30"
               when "rejected" then "bg-red-400/10 text-red-400 border border-red-400/30"
               else                 "bg-slate-700 text-slate-400"
               end %>
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= css_class %>">
  <%= deposit.status.capitalize %>
</span>